diff --git a/test/presentation/player_muted_test.dart b/test/presentation/player_muted_test.dart
new file mode 100644
index 0000000..9052020
--- /dev/null
+++ b/test/presentation/player_muted_test.dart
@@ -0,0 +1,67 @@
+import 'package:chorki_player/chorki_player.dart';
+import 'package:chorki_player/src/presentation/player/player_audio.dart';
+import 'package:flutter/material.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:video_player_platform_interface/video_player_platform_interface.dart'
+    show VideoPlayerPlatform;
+
+import '../fakes/fake_video_player_platform.dart';
+
+void main() {
+  late FakeVideoPlayerPlatform platform;
+  late MemoryAnalyticsSink sink;
+
+  setUp(() {
+    platform = FakeVideoPlayerPlatform();
+    VideoPlayerPlatform.instance = platform;
+    sink = MemoryAnalyticsSink();
+  });
+
+  Future<void> pump(WidgetTester tester, {required bool muted}) async {
+    await tester.pumpWidget(
+      MaterialApp(
+        home: ChorkiPlayer.url(
+          'https://test.local/a.mp4',
+          muted: muted,
+          analytics: ChorkiAnalyticsConfig(
+            sinks: [sink],
+            heartbeatInterval: const Duration(hours: 1),
+          ),
+        ),
+      ),
+    );
+    for (var i = 0; i < 5; i++) {
+      await tester.pump();
+    }
+  }
+
+  testWidgets('not muted by default: the volume is left alone', (t) async {
+    await pump(t, muted: false);
+    expect(platform.volumeCalls.where((c) => c.$2 == 0), isEmpty);
+    await t.pumpWidget(const SizedBox());
+  });
+
+  testWidgets('muted starts at 0 and is not reported', (t) async {
+    await pump(t, muted: true);
+    expect(platform.volumeCalls.last.$2, 0);
+    expect(sink.types, isNot(contains(ChorkiAnalyticsEventType.volumeChange)));
+    await t.pumpWidget(const SizedBox());
+  });
+
+  testWidgets('muting a playing player later is reported', (t) async {
+    await pump(t, muted: false);
+    await pump(t, muted: true);
+    expect(platform.volumeCalls.last.$2, 0);
+    expect(sink.types, contains(ChorkiAnalyticsEventType.volumeChange));
+    await t.pumpWidget(const SizedBox());
+  });
+
+  testWidgets('applyMuted sets 0 or 1', (t) async {
+    final c = await t.runAsync(() => createTestController(platform));
+    applyMuted(c!, muted: true);
+    expect(c.value.volume, 0);
+    applyMuted(c, muted: false);
+    expect(c.value.volume, 1);
+    await t.runAsync(c.dispose);
+  });
+}
