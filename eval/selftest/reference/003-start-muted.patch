@@ -0,0 +1,8 @@
+import 'package:video_player/video_player.dart';
+
+import '../../core/guard.dart';
+
+/// Sets [controller] to volume 0 when [muted], else back to full volume.
+void applyMuted(VideoPlayerController controller, {required bool muted}) {
+  fireAndReport(() => controller.setVolume(muted ? 0 : 1), 'player.setMuted');
+}
