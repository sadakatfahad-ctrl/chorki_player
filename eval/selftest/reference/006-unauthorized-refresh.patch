 /// Builds the [Dio] client the player uses for its own requests.
@@ -55,9 +56,53 @@ class ApiClient {
         ),
       );
     }
+    final onUnauthorized = config.onUnauthorized;
+    if (onUnauthorized != null) {
+      dio.interceptors.add(_RefreshOn401(dio, onUnauthorized));
+    }
     return dio;
   }
 
   /// Closes the client's connections.
   void close() => _dio?.close(force: true);
 }
+
+/// Retries a request once after [ChorkiNetworkConfig.onUnauthorized]
+/// allowed it.
+class _RefreshOn401 extends Interceptor {
+  _RefreshOn401(this._dio, this._onUnauthorized);
+
+  final Dio _dio;
+  final Future<bool> Function() _onUnauthorized;
+
+  static const String _retried = 'chorki.retriedAfter401';
+
+  @override
+  Future<void> onError(
+    DioException err,
+    ErrorInterceptorHandler handler,
+  ) async {
+    final options = err.requestOptions;
+    if (err.response?.statusCode != 401 || options.extra[_retried] == true) {
+      handler.next(err);
+      return;
+    }
+    bool retry;
+    try {
+      retry = await _onUnauthorized();
+    } catch (e, st) {
+      ChorkiDiagnostics.report(e, st, 'network.onUnauthorized');
+      retry = false;
+    }
+    if (!retry) {
+      handler.next(err);
+      return;
+    }
+    options.extra[_retried] = true;
+    try {
+      handler.resolve(await _dio.fetch<dynamic>(options));
+    } on DioException catch (again) {
+      handler.next(again);
+    }
+  }
+}
