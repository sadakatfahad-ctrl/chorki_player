diff --git a/test/network/unauthorized_refresh_test.dart b/test/network/unauthorized_refresh_test.dart
new file mode 100644
index 0000000..1ed25ab
--- /dev/null
+++ b/test/network/unauthorized_refresh_test.dart
@@ -0,0 +1,127 @@
+import 'dart:typed_data';
+
+import 'package:chorki_player/chorki_player.dart';
+import 'package:chorki_player/src/network/api_client.dart';
+import 'package:dio/dio.dart';
+import 'package:flutter_test/flutter_test.dart';
+
+import '../support/diagnostics.dart';
+
+class _Adapter implements HttpClientAdapter {
+  _Adapter(this.statuses);
+  final List<int> statuses;
+  final List<String?> auth = [];
+
+  @override
+  Future<ResponseBody> fetch(
+    RequestOptions options,
+    Stream<Uint8List>? requestStream,
+    Future<void>? cancelFuture,
+  ) async {
+    auth.add(options.headers['Authorization'] as String?);
+    return ResponseBody.fromString('{}', statuses.removeAt(0));
+  }
+
+  @override
+  void close({bool force = false}) {}
+}
+
+Future<Response<dynamic>> _get(ApiClient c) => c.dio.get<dynamic>(
+  'https://api.test/r',
+  options: Options(validateStatus: (s) => s == 200),
+);
+
+void main() {
+  test(
+    'a 401 asks onUnauthorized, then retries once with new headers',
+    () async {
+      var token = 'old';
+      var calls = 0;
+      final client = ApiClient(
+        ChorkiNetworkConfig(
+          useHttp2: false,
+          headersProvider: () async => {'Authorization': token},
+          onUnauthorized: () async {
+            calls++;
+            token = 'new';
+            return true;
+          },
+        ),
+      );
+      final adapter = _Adapter([401, 200]);
+      client.dio.httpClientAdapter = adapter;
+      expect((await _get(client)).statusCode, 200);
+      expect(calls, 1);
+      expect(adapter.auth, ['old', 'new']);
+    },
+  );
+
+  test('false means no retry', () async {
+    final client = ApiClient(
+      ChorkiNetworkConfig(useHttp2: false, onUnauthorized: () async => false),
+    );
+    final adapter = _Adapter([401]);
+    client.dio.httpClientAdapter = adapter;
+    await expectLater(_get(client), throwsA(isA<DioException>()));
+    expect(adapter.auth, hasLength(1));
+  });
+
+  test('a second 401 fails without asking again', () async {
+    var calls = 0;
+    final client = ApiClient(
+      ChorkiNetworkConfig(
+        useHttp2: false,
+        onUnauthorized: () async {
+          calls++;
+          return true;
+        },
+      ),
+    );
+    final adapter = _Adapter([401, 401]);
+    client.dio.httpClientAdapter = adapter;
+    await expectLater(_get(client), throwsA(isA<DioException>()));
+    expect(adapter.auth, hasLength(2));
+    expect(calls, 1);
+  });
+
+  test('a throwing onUnauthorized is reported and fails the request', () async {
+    final reports = captureDiagnostics();
+    final client = ApiClient(
+      ChorkiNetworkConfig(
+        useHttp2: false,
+        onUnauthorized: () async => throw StateError('refresh failed'),
+      ),
+    );
+    client.dio.httpClientAdapter = _Adapter([401]);
+    await expectLater(_get(client), throwsA(isA<DioException>()));
+    expect(reports, ['network.onUnauthorized']);
+  });
+
+  test('other errors pass straight through', () async {
+    var calls = 0;
+    final client = ApiClient(
+      ChorkiNetworkConfig(
+        useHttp2: false,
+        onUnauthorized: () async {
+          calls++;
+          return true;
+        },
+      ),
+    );
+    client.dio.httpClientAdapter = _Adapter([500]);
+    await expectLater(_get(client), throwsA(isA<DioException>()));
+    expect(calls, 0);
+  });
+
+  test('onUnauthorized is part of equality', () {
+    Future<bool> refresh() async => true;
+    expect(
+      ChorkiNetworkConfig(onUnauthorized: refresh),
+      ChorkiNetworkConfig(onUnauthorized: refresh),
+    );
+    expect(
+      ChorkiNetworkConfig(onUnauthorized: refresh),
+      isNot(const ChorkiNetworkConfig()),
+    );
+  });
+}
