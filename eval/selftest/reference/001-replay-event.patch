diff --git a/test/scenarios/033_replay.yaml b/test/scenarios/033_replay.yaml
new file mode 100644
index 0000000..7cc2699
--- /dev/null
+++ b/test/scenarios/033_replay.yaml
@@ -0,0 +1,24 @@
+name: replay
+description: going back to the start after the end reports one replay; a later seek to 0 does not
+given: {duration: 10s}
+steps:
+  - bind
+  - value: {initialized: true}
+  - activate
+  - play: {to: 10s}
+  - value: {playing: false, completed: true}
+  - seek: {to: 0s, source: api}
+  - value: {completed: false}
+  - play: {to: 4s}
+  - seek: {to: 0s, source: scrub}
+  - deactivate: swipedAway
+expect:
+  mode: subsequence
+  events:
+    - complete
+    - seek: {fromMs: 10000, toMs: 0}
+    - replay: {fromMs: 10000}
+    - seek: {fromMs: 4000, toMs: 0}
+    - sessionEnd: {seekCount: 2}
+  matomo:
+    - {e_a: replay, e_v: "10"}
